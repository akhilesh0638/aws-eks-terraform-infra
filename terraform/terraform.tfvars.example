aws_region       = "ap-south-1"
vpc-cidr         = "10.0.0.0/16"
cidr-block       = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24", "10.0.4.0/24", "10.0.5.0/24", "10.0.6.0/24"]
az               = ["ap-south-1a", "ap-south-1b"]
rtb-cidr         = "0.0.0.0/0"
eip-domain       = "vpc"
sg-name          = "project-web-sg"
for-each         = [22, 80, 8080, 3306]
protocol         = "tcp"
ipv4-cidr        = ["0.0.0.0/0"]
ipv6-cidr        = ["::/0"]
egress-protocol  = "-1"
cluster_name     = "ecommerce-dev-eks"
eks_cluster_role = "eks-cluster-role"
eks_node_role    = "eks_node_role"
db_name          = "mysqleks"
db_username      = "admin"
db_password      = "REPLACE_ME"
